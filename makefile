# name of produced executable
EXE=roll
# cflags needed for every build
CFLAGS ?= $(shell cat compile_flags.txt)
# linker flags needed for every build
LDFLAGS ?=

CFLAGS += -MMD # generate .d files
# cflags needed only for release builds
OPT_CFLAGS ?= -O3 -march=native -mtune=native -flto
OPT_CFLAGS += $(CFLAGS)

# Look for source files that have both header and code files
OBJECT_SRC = $(filter $(patsubst %.h,%.c,$(wildcard ./src/*.h)),$(wildcard ./src/*.c))
# object files to generate. Discover via headers to avoid main() clash
OBJECTS = $(patsubst src/%.c, out/%.o, $(OBJECT_SRC))

DEBUG_OBJECTS = $(patsubst %.o, %-dbg.o, $(OBJECTS))
#TEST_OBJECTS = $(patsubst test/%.c, test-out/%.so, $(wildcard test/*.c))

out/$(EXE): $(OBJECTS) out/roll.o
	cc $(OPT_CFLAGS) $^ $(LDFLAGS) -o $@
out/$(EXE)-dbg: $(DEBUG_OBJECTS) out/toll-dbg.o
	cc -g $(CFLAGS) $^ $(LDFLAGS) -o $@
#out/$(EXE)-test.so: $(DEBUG_OBJECTS)
#	cc -shared -g $(CFLAGS) $^ $(LDFLAGS) -o $@

out/%.o: src/%.c
	mkdir -p $(@D)
	cc -c $(OPT_CFLAGS) $< -o $@
out/%-dbg.o: src/%.c
	mkdir -p $(@D)
	cc -g -c $(CFLAGS) $< -o $@

# .d files are generated by gcc to enable incremental builds
-include $(wildcard out/*.d)
#-include $(wildcard test-out/*.d)

.PHONY: run test --

